        end
        targetTab.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
        btn.TextColor3 = Color3.fromRGB(10, 10, 16)
    end)
    
    if index == 1 then
        targetTab.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
        btn.TextColor3 = Color3.fromRGB(10, 10, 16)
    end
end

